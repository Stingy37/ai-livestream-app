# Copy this file to .env (same folder) and fill in your own values.
# .env is gitignored: never commit real keys. Share them privately.
# Real environment variables always win over values in .env.

# Lumen LLM (UIUC). Used by the scraper's discovery agent and by QC.
# Without it the scraper still runs, but discovery cannot use the LLM.
LUMEN_API_KEY=

# Search, tried in this order: SearXNG (free) -> Tavily (paid) -> ddgs (free, last resort).
# Leave a line empty to skip that step.

# Base URL of a SearXNG instance with the JSON API on, e.g. http://localhost:8888
# (see src/scraper/searxng/README.md to run one locally).
SEARXNG_URL=

# Only needed to run the local SearXNG from src/scraper/searxng/docker-compose.yml.
# Any long random string, e.g. python -c "import secrets; print(secrets.token_hex(32))"
SEARXNG_SECRET=

# Tavily, the paid fallback (1 credit per search, used only when SearXNG fails).
TAVILY_API_KEY=

# Optional: extra contact (e.g. a team email) added to the scraper's User-Agent.
SCRAPER_CONTACT=
