# Pipelines for the Cyclone Murasu streams on Karthik's ICRN slice (ksista2): Andy's default paths pointed at this
# account. No secrets here. Load with: set -a; source saved_configs/murasu_ksista2.env; set +a
PY=/home/ksista2/.conda/envs/murasu-live/bin/python
UDOCKER=/home/ksista2/.local/bin/udocker
MMS_DIR=/home/ksista2/pre-models
PARLER_DIR=/home/ksista2/pre-models/indic-parler-tts
KOKORO_DIR=/home/ksista2/pre-models/Kokoro-82M
DESK_CACHE_DIR=/home/ksista2/murasu-live/output/desk/cache
SCRAPE_CACHE_DIR=/home/ksista2/murasu-live/output/scrape_cache
START_SERVICES=0
DESK_REGION=nio
DESK_STORM=MURASU
DESK_JTWC_ID=io0426
MAX_HOURS=30
# stream ids: india-murasu-te (CONFIG_PATH=saved_configs/india_te.json), india-murasu-en (saved_configs/india_en.json)

# EC2 address that answers from this slice (2 Nov; the Elastic IP 32.201.48.210 did not answer)
EC2_SSH_HOST=ubuntu@184.194.177.117
EC2_API_URL=https://184.194.177.117:8443/
