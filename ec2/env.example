# /etc/weather-livestream/env  (deploy.sh writes the real one; owner ubuntu, mode 600)
API_TOKEN=<64 hex chars, `openssl rand -hex 32`>
BUCKET=weather-livestream-716747745410-dev
REGION=us-east-1
DATA_DIR=/home/ubuntu/weather-livestream-data
WEB_DIR=/home/ubuntu/weather-livestream/html
BIND=0.0.0.0
PORT=8443
CERT=/etc/weather-livestream/tls/server.crt
KEY=/etc/weather-livestream/tls/server.key
KEEP_PACKAGES=3
PRESIGN_TTL=900
